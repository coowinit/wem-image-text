{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wem/image-text",
  "version": "1.0.0",
  "title": "WEM Image Text",
  "category": "design",
  "icon": "columns",
  "description": "Responsive image and content layout for Gutenberg.",
  "textdomain": "wem-image-text",
  "attributes": {
    "desktopLayout": {
      "type": "string",
      "default": "image-left"
    },
    "mobileOrder": {
      "type": "string",
      "default": "image-first"
    },
    "imageWidth": {
      "type": "number",
      "default": 50
    },
    "gap": {
      "type": "number",
      "default": 24
    },
    "imageRadius": {
      "type": "number",
      "default": 0
    },
    "mobileTextMargin": {
      "type": "number",
      "default": 16
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "wem-image-text-editor",
  "editorStyle": "file:./assets/css/editor.css",
  "style": "file:./assets/css/frontend.css"
}
